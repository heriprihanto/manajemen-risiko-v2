# Salin ke BackEnd/.env dan sesuaikan dengan server email.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=survei@example.com
SMTP_STARTTLS=true
SMTP_SSL=false
# URL halaman survei, termasuk sub-path deployment bila digunakan.
SURVEI_PUBLIC_URL=https://example.com/manajemen-risiko/survei

# Gateway WhatsApp (perangkat harus sudah terhubung).
WHATSAPP_GATEWAY_URL=http://localhost:3000/send/message
WHATSAPP_DEVICE_ID=eMonev
