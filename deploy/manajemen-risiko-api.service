# systemd unit untuk backend FastAPI (uvicorn).
# Pasang: sudo cp deploy/manajemen-risiko-api.service /etc/systemd/system/
#         sudo systemctl daemon-reload
#         sudo systemctl enable --now manajemen-risiko-api
# Sesuaikan User, WorkingDirectory, dan path .venv dengan server Anda.
[Unit]
Description=Manajemen Risiko API (FastAPI/uvicorn)
After=network.target postgresql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/manajemen-risiko/BackEnd
# EnvironmentFile berisi kredensial DB dsb. (BackEnd/.env)
EnvironmentFile=/var/www/manajemen-risiko/BackEnd/.env
ExecStart=/var/www/manajemen-risiko/BackEnd/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8077
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
